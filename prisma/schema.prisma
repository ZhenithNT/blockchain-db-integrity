generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------- Tài khoản và ví ----------------

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(100)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  fullName     String   @default("") @map("full_name") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at")

  wallet UserWallet?

  @@map("users")
}

/// Mỗi admin có một ví. Khóa riêng được mã hóa bằng mật khẩu của chính người đó.
model UserWallet {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique @map("user_id")
  address      String   @unique @db.VarChar(42)
  encryptedKey String   @map("encrypted_key") @db.Text
  status       String   @default("ACTIVE") @db.VarChar(20) // ACTIVE, REVOKED
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_wallets")
}

// ---------------- Danh mục để chọn khi nhập điểm ----------------

model Semester {
  id   Int    @id @default(autoincrement())
  code String @unique @db.VarChar(50) // ví dụ "2025-2026.1"
  name String @db.VarChar(100)

  @@map("semesters")
}

model Course {
  id      Int    @id @default(autoincrement())
  code    String @unique @db.VarChar(50) // ví dụ "BAS1111"
  name    String @db.VarChar(150)
  credits Int    @default(3)

  @@map("courses")
}

model Student {
  id          Int    @id @default(autoincrement())
  studentCode String @unique @map("student_code") @db.VarChar(50) // ví dụ "B23DCAT111"
  fullName    String @map("full_name") @db.VarChar(100)
  className   String @default("D23CQAT01-B") @map("class_name") @db.VarChar(50)

  @@map("students")
}

// ---------------- Điểm và lịch sử ----------------

model Score {
  id        Int      @id @default(autoincrement())
  studentId String   @map("student_id") @db.VarChar(50)
  courseCode String  @map("course_code") @db.VarChar(50)
  semester  String   @db.VarChar(50)
  score     String   @db.VarChar(10) // "8.50"
  version   Int      @default(1)
  recordKey String   @map("record_key") @db.VarChar(66)
  dataHash  String   @map("data_hash") @db.VarChar(66)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  versions        ScoreVersion[]
  integrityChecks IntegrityCheck[]

  @@unique([studentId, courseCode, semester], name: "unique_student_course_semester")
  @@index([recordKey])
  @@map("scores")
}

model ScoreVersion {
  id              Int      @id @default(autoincrement())
  scoreId         Int      @map("score_id")
  version         Int
  score           String   @db.VarChar(10)
  action          String   @db.VarChar(20) // CREATE, UPDATE
  dataHash        String   @map("data_hash") @db.VarChar(66)
  transactionHash String?  @map("transaction_hash") @db.VarChar(66)
  blockNumber     BigInt?  @map("block_number")
  createdAt       DateTime @default(now()) @map("created_at")

  scoreRef Score @relation(fields: [scoreId], references: [id], onDelete: Cascade)

  @@unique([scoreId, version], name: "unique_score_version")
  @@index([scoreId])
  @@map("score_versions")
}

// ---------------- Nhật ký ----------------

model AuditLog {
  id         Int      @id @default(autoincrement())
  actor      String   @db.VarChar(100)
  action     String   @db.VarChar(50)
  target     String   @db.VarChar(100)
  beforeData String?  @map("before_data") @db.Text
  afterData  String?  @map("after_data") @db.Text
  ip         String?  @db.VarChar(50)
  timestamp  DateTime @default(now())

  @@map("audit_logs")
}

model IntegrityCheck {
  id                Int      @id @default(autoincrement())
  scoreId           Int?     @map("score_id")
  recordKey         String?  @map("record_key") @db.VarChar(66)
  databaseHash      String?  @map("database_hash") @db.VarChar(66)
  blockchainHash    String?  @map("blockchain_hash") @db.VarChar(66)
  databaseVersion   Int?     @map("database_version")
  blockchainVersion Int?     @map("blockchain_version")
  result            String   @db.VarChar(20) // VALID, INVALID, ERROR
  reason            String?  @db.VarChar(50)
  details           String   @db.Text
  checkedAt         DateTime @default(now()) @map("checked_at")

  scoreRef Score? @relation(fields: [scoreId], references: [id], onDelete: SetNull)

  @@index([scoreId])
  @@index([recordKey])
  @@map("integrity_checks")
}
