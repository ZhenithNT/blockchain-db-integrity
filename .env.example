# ==========================================
# Môi trường ứng dụng Blockchain DB Integrity
# ==========================================

# Cấu hình kết nối MySQL
DATABASE_URL="mysql://root:@localhost:3306/blockchain_db_integrity"

# Cổng Backend API
PORT=4000

# Khóa bí mật ký JSON Web Token
JWT_SECRET="demo-blockchain-db-integrity-jwt-secret-key-2026"

# Cấu hình kết nối Blockchain Hardhat Node
BLOCKCHAIN_RPC_URL="http://127.0.0.1:8545"

# Địa chỉ Contract IntegrityRegistry sau khi deploy
CONTRACT_ADDRESS="0x5FbDB2315678afecb367f032d93F642f64180aa3"

# Private key của tài khoản ghi bằng chứng (Account #0 mặc định của Hardhat)
DEPLOYER_PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"

# Bật tính năng tấn công giả lập dữ liệu cho mục đích thuyết trình demo
ENABLE_DEMO_ATTACKS=true

# Môi trường chạy
NODE_ENV=development
